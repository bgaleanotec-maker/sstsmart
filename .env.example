# Copia a .env y completa. NUNCA subir .env a git.
FLASK_CONFIG=development
SECRET_KEY=cambia-esto-en-produccion
JWT_SECRET_KEY=cambia-esto-tambien
DATABASE_URL=sqlite:///sst.db

# IA (Google Gemini) - crear key en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Correo (SendGrid). Sin key, los correos se imprimen en consola (modo dev)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=notificaciones@tudominio.com

# URL pública para links en correos
BASE_URL=http://localhost:5000

# Scheduler de escalamiento automático (1=on, 0=off)
SCHEDULER_ENABLED=1

# Cumplimiento: XML público de la lista consolidada de la ONU para verificar
# contrapartes (p. ej. https://scsanctions.un.org/resources/xml/sp/consolidated.xml).
# Vacío = solo consulta manual con enlaces a ONU/OFAC/UE.
LISTA_ONU_URL=
